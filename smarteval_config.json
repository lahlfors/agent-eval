{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartEval Agent Evaluation Configuration",
  "description": "Declarative execution configuration for Google SmartEval unified DAG pipeline (go/gcp-smart-eval) and Vertex AI Experiments",
  "version": "1.0.0",
  "experiment_name": "agent-eval-2x3-matrix",
  "pipeline_type": "vertex_dag",
  "runner": {
    "engine": "google-adk",
    "entrypoint": "personalized_shopping.agent:root_agent",
    "adapter_class": "agent_eval_framework.adapters.adk_adapter.ADKAgentAdapter"
  },
  "dataset": {
    "gcs_uri": "gs://${GCS_EVAL_BUCKET}/datasets/golden_record_2x3_matrix.jsonl",
    "fallback_local_path": "agent-eval-framework/data/vertex_eval_data/golden_record_2x3_matrix.jsonl",
    "format": "jsonl",
    "column_mapping": {
      "prompt": "prompt",
      "reference": "reference",
      "reference_trajectory": "reference_trajectory"
    }
  },
  "model_matrix": [
    {
      "name": "gemini-3.7-flash",
      "provider": "google-vertexai",
      "role": "candidate",
      "temperature": 0.2
    },
    {
      "name": "claude-3-7-sonnet",
      "provider": "anthropic-vertexai",
      "role": "baseline",
      "temperature": 0.2
    }
  ],
  "target_metrics": [
    {
      "name": "exact_match",
      "type": "computation"
    },
    {
      "name": "bleu",
      "type": "computation"
    },
    {
      "name": "rouge_l_sum",
      "type": "computation"
    },
    {
      "name": "cost_savings_multiplier",
      "type": "custom_function",
      "custom_function_path": "agent_eval_framework.metrics.tokenomics_metrics.cost_savings_multiplier"
    },
    {
      "name": "token_cost_usd",
      "type": "custom_function",
      "custom_function_path": "agent_eval_framework.metrics.tokenomics_metrics.token_cost_usd"
    },
    {
      "name": "multi_turn_token_growth_rate",
      "type": "custom_function",
      "custom_function_path": "agent_eval_framework.metrics.tokenomics_metrics.multi_turn_token_growth_rate"
    }
  ],
  "output": {
    "vertex_experiments_tracking": true,
    "cloud_trace_export": true,
    "export_format": "html_and_json"
  }
}
